[Unit]
Description=Sudoku server
Documentation=https://github.com/jesserockz/sudoku/tree/main/deploy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sudoku
Group=sudoku
ExecStart=/opt/sudoku/bin/sudoku-server -config /etc/sudoku/config.toml
# Secrets (SUDOKU_SERVER_SECRET) live here, readable only by root and sudoku.
EnvironmentFile=-/etc/sudoku/env
# Restart=on-failure also restarts the server after an admin self-update: the
# server exits with status 75 (EX_TEMPFAIL), which counts as a failure, so
# systemd starts the new binary. Do not change it to Restart=no.
Restart=on-failure
RestartSec=5

# /var/lib/sudoku, owned by the service user; holds the SQLite database.
StateDirectory=sudoku
StateDirectoryMode=0750
WorkingDirectory=/var/lib/sudoku

# /opt/sudoku must be owned by the service user: the admin self-update writes
# the new binary next to the running one in bin/ (keeping the old one as
# sudoku-server.previous) and swaps the web/ directory with a staged copy
# (keeping the old one as web.previous). ProtectSystem=strict makes everything
# else read-only, so the directory has to be listed here.
ReadWritePaths=/opt/sudoku

# Hardening. The server only needs its state dir, /opt/sudoku above,
# and outbound HTTPS to Authentik for the JWKS plus, for self-update, to
# api.github.com and GitHub's release asset storage.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
