[Unit]
Description=Back up the sudoku SQLite database
Documentation=https://github.com/jesserockz/sudoku/tree/main/deploy

[Service]
Type=oneshot
User=sudoku
Group=sudoku
Environment=DB=/var/lib/sudoku/sudoku.db
Environment=BACKUP_DIR=/var/backups/sudoku
Environment=KEEP_DAYS=30
ExecStart=/usr/local/bin/sudoku-backup
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sudoku /var/backups/sudoku
